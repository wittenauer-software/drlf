{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/drlf/public-release-policy.schema.json",
  "title": "Public release checker policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_version",
    "bounds",
    "decisions",
    "required_paths",
    "forbidden_path_prefixes",
    "synthetic_registry_path",
    "check_markdown_links",
    "require_clean_worktree",
    "require_root_commit",
    "approved_inventory_sha256",
    "deny_inventory_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "policy_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_paths",
        "max_path_bytes",
        "max_file_bytes",
        "max_total_bytes",
        "max_runtime_seconds",
        "max_git_output_bytes",
        "max_git_objects",
        "max_structured_bytes",
        "max_deny_rules",
        "max_findings"
      ],
      "properties": {
        "max_paths": {"type": "integer", "minimum": 1, "maximum": 20000},
        "max_path_bytes": {"type": "integer", "minimum": 64, "maximum": 4096},
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 33554432},
        "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "max_git_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 41943040},
        "max_git_objects": {"type": "integer", "minimum": 1, "maximum": 20000},
        "max_structured_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "max_deny_rules": {"type": "integer", "minimum": 1, "maximum": 5000},
        "max_findings": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_owner",
        "repository_name",
        "package_name",
        "license_spdx",
        "license_path",
        "contribution_policy_path",
        "code_of_conduct_path",
        "governance_path",
        "security_path",
        "support_path",
        "commit_author_name",
        "commit_author_email",
        "commit_committer_name",
        "commit_committer_email",
        "approved_public_contacts"
      ],
      "properties": {
        "repository_owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$"
        },
        "repository_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,99}$"
        },
        "package_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,99}$"
        },
        "license_spdx": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]{1,63}$"
        },
        "license_path": {"$ref": "#/$defs/relativePath"},
        "contribution_policy_path": {"$ref": "#/$defs/relativePath"},
        "code_of_conduct_path": {"$ref": "#/$defs/relativePath"},
        "governance_path": {"$ref": "#/$defs/relativePath"},
        "security_path": {"$ref": "#/$defs/relativePath"},
        "support_path": {"$ref": "#/$defs/relativePath"},
        "commit_author_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "commit_author_email": {"type": "string", "format": "email", "maxLength": 320},
        "commit_committer_name": {"type": "string", "minLength": 1, "maxLength": 256},
        "commit_committer_email": {"type": "string", "format": "email", "maxLength": 320},
        "approved_public_contacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 3, "maxLength": 2048}
        }
      }
    },
    "required_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "forbidden_path_prefixes": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/relativePath"}
    },
    "synthetic_registry_path": {"$ref": "#/$defs/relativePath"},
    "check_markdown_links": {"type": "boolean"},
    "require_clean_worktree": {"type": "boolean"},
    "require_root_commit": {"type": "boolean"},
    "approved_parent_commits": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
    },
    "approved_inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deny_inventory_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f]).+$"
    }
  }
}
