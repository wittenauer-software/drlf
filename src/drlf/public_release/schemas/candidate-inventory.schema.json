{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/drlf/public-release-candidate-inventory.schema.json",
  "title": "Approved public candidate inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "inventory_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes",
          "sha256",
          "git_mode",
          "classification",
          "content_type"
        ],
        "properties": {
          "path": {"$ref": "#/$defs/relativePath"},
          "bytes": {"type": "integer", "minimum": 0, "maximum": 33554432},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "git_mode": {"enum": ["100644", "100755"]},
          "classification": {
            "enum": ["copy-after-review", "rewrite", "synthetic-replacement"]
          },
          "content_type": {"const": "text"}
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001f\\u007f]).+$"
    }
  }
}
