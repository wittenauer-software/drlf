# Use a unique value for each private workspace. Never commit the completed .env.
COMPOSE_PROJECT_NAME=drlf-change-this-workspace-id
POSTGRES_DB=drlf
POSTGRES_USER=drlf
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://drlf:replace-with-a-local-password@127.0.0.1:5432/drlf
